# =========================================================
# AI Vendor Outreach Platform - environment configuration
# Copy to .env and fill in real values:
#     cp .env.example .env
#   Then edit. Generate a secret key with: openssl rand -hex 32
# Never commit .env. Values left empty use the safe defaults.
# =========================================================

# ---------------- Core ----------------
ENVIRONMENT=production            # development | test | production
DEBUG=false
SECRET_KEY=change-me-in-production # REQUIRED: openssl rand -hex 32
# BASE_URL/CORS_ORIGINS are set automatically by scripts/install.sh to the
# https://<your-domain> you provide during installation.
BASE_URL=http://localhost          # public URL (used for absolute links/OAuth redirect)
CORS_ORIGINS=http://localhost      # comma-separated (same-origin via proxy needs no change)
DEMO_MODE=false

# ---------------- Database / queue ----------------
# Compose overrides these to point at the postgres/redis services.
# For local (non-Docker) dev set them explicitly:
# DATABASE_URL=postgresql+asyncpg://outreach:outreach@127.0.0.1:5432/outreach
# REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach-change-me
POSTGRES_DB=outreach

# ---------------- Initial admin (first boot) ----------------
# If all three are set and no user exists, the first API boot creates
# the initial admin. Otherwise use the /api/setup wizard in the UI.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# ---------------- AI (OpenRouter / OpenAI-compatible) ----------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=900
AI_REPLY_MODE=delayed            # immediate | delayed
AI_REPLY_MIN_DELAY_MINUTES=3
AI_REPLY_MAX_DELAY_MINUTES=10

# ---------------- Gmail ----------------
# GMAIL_TRANSPORT: auto | smtp | api | fake
#   auto = API if OAuth credentials exist, otherwise fake (demo/dry-run).
# The compose stack stores the OAuth token in the appdata volume.
# scripts/install.sh sets GOOGLE_REDIRECT_URI to
# https://<your-domain>/api/integrations/gmail/oauth/callback automatically.
GMAIL_TRANSPORT=auto
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=
GMAIL_PLAIN_TEXT=false

# ---------------- SMTP (Microsoft 365/Outlook or any provider) ----------------
# Used when GMAIL_TRANSPORT=smtp or when the Gmail transport falls back to
# SMTP. Also configurable later from the web panel (Settings -> Email).
# Defaults below match SMTP with STARTTLS on port 587 (e.g. Outlook.com).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=true                  # true = STARTTLS on 587, false = plain 25/465

# ---------------- Vendor discovery & research ----------------
DISCOVERY_PROVIDER=demo          # demo | api
DISCOVERY_API_URL=
DISCOVERY_API_KEY=
RESEARCH_USER_AGENT=
RESEARCH_TIMEOUT_SECONDS=20
RESEARCH_POLITENESS_SECONDS=1

# ---------------- Telegram operator notifications ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------- Sending defaults (overridable per campaign) ----------------
SEND_BATCH_SIZE=1
SEND_MIN_DELAY_MINUTES=5
SEND_MAX_DELAY_MINUTES=12
DAILY_MAX_EMAILS=30
SENDING_START_HOUR=9
SENDING_END_HOUR=17
SENDING_DAYS=1,2,3,4,5            # ISO weekdays, 1=Monday
CAMPAIGN_TIMEZONE=America/New_York

# ---------------- Worker / scheduler ----------------
DISPATCH_INTERVAL_SECONDS=60
SCHEDULER_INTERVAL_SECONDS=300
JOB_RETENTION_DAYS=30
JOB_STALE_AFTER_SECONDS=300
GUNICORN_WORKERS=2                # API worker processes

# ---------------- Reverse proxy / TLS ----------------
HTTP_PORT=80
HTTPS_PORT=443
# Let's Encrypt email used by scripts/install.sh for certificate issuance
# and renewal notices. Leave empty to be prompted during installation.
LETSENCRYPT_EMAIL=
# NEXT_PUBLIC_API_URL is baked into the frontend at build time.
# Relative /api = same origin served by the reverse proxy (recommended).
# scripts/install.sh keeps this at /api (do not change for VPS installs).
NEXT_PUBLIC_API_URL=/api